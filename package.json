{
  "name": "printrm-portable",
  "version": "1.0.0",
  "description": "Portable 3D Slicing App with React and Spring Boot",
  "main": "main.js",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && gradlew.bat bootRun --args=\"--server.port=8080\"",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development ELECTRON_START_URL=http://localhost:5173 electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:web": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && gradlew.bat stageApp",
    "dist": "npm run build:frontend && npm run build:backend && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^34.0.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.printrm.portable",
    "win": {
      "target": "portable",
      "icon": "frontend/public/vite.svg"
    },
    "directories": {
      "output": "output/printcrm"
    },
    "files": [
      "main.js",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/build/staging/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/build/staging/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/configs",
        "to": "configs"
      }
    ]
  }
}
